{
  "name": "jev-router-eval",
  "version": "0.1.0",
  "description": "Evaluate whether TypeSafe's Jev can route coding-agent prompts to cheap / standard / frontier model tiers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "jev-router-eval": "src/cli.ts"
  },
  "scripts": {
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
